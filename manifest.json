{
  "manifest_version": 3,
  "name": "小 A 翻译",
  "version": "2026.11.10",
  "description": "比同类翻译插件更轻量，只专注两件事：网页双语对照翻译、YouTube 双语字幕。无冗余功能。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["config.js", "utils.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }, {
    "matches": ["<all_urls>"],
    "js": ["selection.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*"],
    "js": ["youtube-hook.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }, {
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*"],
    "js": ["youtube.js"],
    "css": ["youtube.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "小 A 翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+A" },
      "description": "翻译 / 切换译文"
    },
    "open-window": {
      "suggested_key": { "default": "Alt+D" },
      "description": "打开独立翻译窗口"
    }
  },
  "options_page": "options.html"
}
