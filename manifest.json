{
  "manifest_version": 3,
  "name": "小 A 翻译",
  "version": "1.1.1",
  "description": "极简双语对照翻译：快捷键一键翻译整页，悬停段落按 Ctrl 单独翻译；YouTube 打开字幕即显示双语字幕。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js", "selection.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["youtube-hook.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": true
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["youtube.js"],
    "css": ["youtube.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "小 A 翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": { "default": "Alt+A" },
      "description": "翻译 / 切换译文"
    },
    "open-window": {
      "suggested_key": { "default": "Alt+D" },
      "description": "打开独立翻译窗口"
    }
  },
  "options_page": "options.html"
}
